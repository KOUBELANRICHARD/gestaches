{
  "name": "gestaches",
  "version": "1.0.0",
  "description": "Application React et Express pour organiser les taches, horaires, formations et notifications.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server.js",
    "check": "node --check server.js",
    "vapid": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "^6.4.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
